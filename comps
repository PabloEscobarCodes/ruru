 * CHART VIEW — shared chart renderer used by CustomChartCard and chat preview
 * ========================================================================== */

export function ChartView({ config }: { config: CustomChartConfig | MockChartTemplate }) {
  const theme = useChartTheme();
  const source = DATA_SOURCES[config.source];
  const series = source.series.filter((s) => config.selectedSeries.includes(s.key));

  if (series.length === 0) {
    return (
      <div className="flex h-full items-center justify-center text-[10px] text-grey3 dark:text-light-blue/60">
        No data selected
      </div>
    );
  }

  const isCircular = config.chartKind === 'pie' || config.chartKind === 'doughnut';
  const transposed = config.xAxisField === 'series';

  // ----- Build data based on xAxisField (transposition) -----
  let chartData: any;

  if (isCircular) {
    if (transposed) {
      chartData = {
        labels: series.map((s) => s.label),
        datasets: [
          {
            data: series.map((s) => s.values.reduce((a, b) => a + b, 0)),
            backgroundColor: series.map((s) => s.color),
            borderWidth: 1,
            borderColor: theme.isDark ? '#111C44' : '#FFFFFF',
          },
        ],
      };
    } else {
      chartData = {
        labels: source.labels,
        datasets: [
          {
            data: source.labels.map((_, i) =>
              series.reduce((sum, s) => sum + s.values[i], 0),
            ),
            backgroundColor: source.labels.map((_, i) => PALETTE[i % PALETTE.length]),
            borderWidth: 1,
            borderColor: theme.isDark ? '#111C44' : '#FFFFFF',
          },
        ],
      };
    }
  } else if (transposed) {
    chartData = {
      labels: series.map((s) => s.label),
      datasets: source.labels.map((label, i) => ({
        label,
        data: series.map((s) => s.values[i]),
        backgroundColor: PALETTE[i % PALETTE.length],
        borderColor: PALETTE[i % PALETTE.length],
        tension: 0.4,
        pointRadius: 2,
        fill: false,
      })),
    };
  } else {
    chartData = {
      labels: source.labels,
      datasets: series.map((s) => ({
        label: s.label,
        data: s.values,
        backgroundColor: s.color,
        borderColor: s.color,
        tension: 0.4,
        pointRadius: 2,
        fill: false,
      })),
    };
  }

  // ----- Options -----
  const baseOptions: any = {
    maintainAspectRatio: false,
    responsive: true,
    plugins: {
      legend: {
        display: true,
        position: 'bottom' as const,
        labels: { color: theme.text, font: { size: 9 }, boxWidth: 8, padding: 4 },
      },
      datalabels: { display: false },
    },
  };

  if (!isCircular) {
    const stacked = config.chartKind === 'stacked-bar';
    baseOptions.scales = {
      x: {
        stacked,
        grid: { display: false },
        ticks: { color: theme.text, font: { size: 9 } },
      },
      y: {
        stacked,
        grid: { color: theme.grid },
        ticks: { color: theme.text, font: { size: 9 } },
      },
    };
    if (config.swapAxes) {
      baseOptions.indexAxis = 'y';
    }
  }

  switch (config.chartKind) {
    case 'line':
      return <Line data={chartData} options={baseOptions} />;
    case 'pie':
      return <Pie data={chartData} options={baseOptions} />;
    case 'doughnut':
      return <Doughnut data={chartData} options={baseOptions} />;
    case 'bar':
    case 'stacked-bar':
    default:
      return <Bar data={chartData} options={baseOptions} />;
  }
}

