                    <input type="submit" name="ipg_sar_submit" id="ipg_sar_submit" value="Submit to leadership & the delegate" className="cursor-pointer bg-kpmg-blue text-white rounded-md px-3 py-2 text-[13px] mr-2 submit_draft_sar" onClick={e => submitDraftSar(e)} />)}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </>
  );
};
