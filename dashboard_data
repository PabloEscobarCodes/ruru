/**
 * Best-match search — returns the highest-scoring mock query.
 * Returns null if no keywords match (caller should show fallback).
 */
export function findMockMatch(query: string): MockQuery | null {
  const q = query.toLowerCase();
  let best: { query: MockQuery; score: number } | null = null;

  for (const m of MOCK_QUERIES) {
    let score = 0;
    for (const kw of m.keywords) {
      if (q.includes(kw)) score++;
    }
    if (score > 0 && (!best || score > best.score)) {
      best = { query: m, score };
    }
  }

  return best?.query ?? null;
}
