export function DiscoveryTrendsCard() {
  const [period, setPeriod] = useState<'monthly' | 'quarterly'>('monthly');
  const theme = useChartTheme();
  const trend = DASHBOARD_DATA.trends[period];

  const data = {
    labels: trend.labels,
    datasets: [
      { label: 'Critical', data: trend.crit, backgroundColor: SEVERITY_COLORS.critical },
      { label: 'High', data: trend.high, backgroundColor: SEVERITY_COLORS.high },
      { label: 'Medium', data: trend.med, backgroundColor: SEVERITY_COLORS.medium },
    ],
  };

  const options = {
    maintainAspectRatio: false,
    responsive: true,
    layout: { padding: { top: 14 } },
    scales: {
      x: { stacked: true, grid: { display: false }, ticks: { color: theme.text, font: { size: 9 } } },
      y: { stacked: true, grid: { color: theme.grid }, ticks: { color: theme.text, font: { size: 9 } } },
    },
    plugins: {
      legend: { display: false },
      datalabels: {
        color: theme.text,
        anchor: 'end' as const,
        align: 'top' as const,
        font: { weight: 700 as const, size: 8 },
        formatter: (_v: number, ctx: any) => {
          const ds = ctx.chart.data.datasets;
          if (ctx.datasetIndex === ds.length - 1) {
            return ds.reduce((s: number, d: any) => s + d.data[ctx.dataIndex], 0);
          }
          return null;
        },
      },
    },
  };

  return (
    <Card title="Discovery Trends">
      <ToggleGroup
        options={[
          { value: 'monthly', label: 'Monthly' },
          { value: 'quarterly', label: 'Quarterly' },
        ]}
        value={period}
        onChange={setPeriod}
      />
      <div className="relative flex-1 min-h-0">
        <Bar data={data} options={options} />
      </div>
    </Card>
  );
}

