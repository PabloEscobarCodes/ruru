/* ============================================================================
 * TOGGLE GROUP
 * ========================================================================== */

export function ToggleGroup<T extends string>({
  options,
  value,
  onChange,
  className = '',
}: {
  options: Array<{ value: T; label: string }>;
  value: T;
  onChange: (v: T) => void;
  className?: string;
}) {
  return (
    <div
      className={`mb-1.5 flex self-center gap-0.5 rounded border border-grey5 bg-grey5/40 p-0.5 dark:border-white/10 dark:bg-[#0F172A] ${className}`}
    >
      {options.map((opt) => {
        const active = opt.value === value;
        return (
          <button
            key={opt.value}
            type="button"
            onClick={() => onChange(opt.value)}
            className={`cursor-pointer rounded px-1.5 py-[2px] text-[7px] font-bold uppercase transition-colors ${
              active
                ? 'bg-kpmg-default text-white'
                : 'bg-transparent text-grey2 dark:text-light-blue/60'
            }`}
          >
            {opt.label}
          </button>
        );
      })}
    </div>
  );
}

/* ============================================================================
 * CUSTOM DROPDOWN  (replaces native <select>; gets cursor-pointer everywhere)
 * ========================================================================== */

export function Dropdown<T extends string>({
  options,
  value,
  onChange,
  placeholder = 'Select...',
}: {
  options: Array<{ value: T; label: string; description?: string }>;
  value: T;
  onChange: (v: T) => void;
  placeholder?: string;
}) {
  const [open, setOpen] = useState(false);
  const ref = useRef<HTMLDivElement>(null);

  useEffect(() => {
    if (!open) return;
    const handler = (e: MouseEvent) => {
      if (ref.current && !ref.current.contains(e.target as Node)) {
        setOpen(false);
      }
    };
    const escHandler = (e: KeyboardEvent) => {
      if (e.key === 'Escape') setOpen(false);
    };
    document.addEventListener('mousedown', handler);
    document.addEventListener('keydown', escHandler);
    return () => {
      document.removeEventListener('mousedown', handler);
      document.removeEventListener('keydown', escHandler);
    };
  }, [open]);

  const selected = options.find((o) => o.value === value);

  return (
    <div ref={ref} className="relative">
      <button
        type="button"
        onClick={() => setOpen((o) => !o)}
        className="flex w-full cursor-pointer items-center justify-between gap-2 rounded-lg border border-grey5 bg-grey5/20 px-3 py-2 text-sm font-medium text-dark-blue transition-all hover:border-kpmg-default/50 hover:bg-white focus:border-kpmg-default focus:bg-white focus:outline-none dark:border-white/10 dark:bg-[#060B28] dark:text-white dark:hover:border-light-blue/40 dark:hover:bg-[#0F172A] dark:focus:bg-[#0F172A]"
      >
        <span className="truncate">{selected?.label ?? placeholder}</span>
        <svg
          className={`shrink-0 text-grey2 transition-transform dark:text-light-blue/60 ${
            open ? 'rotate-180' : ''
          }`}
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          strokeWidth="2.5"
          strokeLinecap="round"
          strokeLinejoin="round"
        >
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </button>

      {open && (
        <div className="absolute left-0 right-0 top-full z-20 mt-1 max-h-64 overflow-y-auto rounded-lg border border-grey5 bg-white py-1 shadow-lg dark:border-white/10 dark:bg-[#0F172A]">
          {options.map((opt) => {
            const active = opt.value === value;
            return (
              <button
                key={opt.value}
                type="button"
                onClick={() => {
                  onChange(opt.value);
                  setOpen(false);
                }}
                className={`flex w-full cursor-pointer items-start justify-between gap-2 px-3 py-2 text-left transition-colors ${
                  active
                    ? 'bg-kpmg-default/10 text-kpmg-default dark:bg-light-blue/10 dark:text-light-blue'
                    : 'text-dark-blue hover:bg-grey5/40 dark:text-white dark:hover:bg-white/5'
                }`}
              >
                <div className="flex-1">
                  <div className="text-sm font-medium">{opt.label}</div>
                  {opt.description && (
                    <div className="mt-0.5 text-[10px] font-normal text-grey2 dark:text-light-blue/60">
                      {opt.description}
                    </div>
                  )}
                </div>
                {active && (
                  <svg
                    className="mt-0.5 shrink-0"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    strokeWidth="2.5"
                    strokeLinecap="round"
                    strokeLinejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                )}
              </button>
            );
          })}
        </div>
      )}
    </div>
  );
}

