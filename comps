            className="cursor-pointer rounded-lg px-4 py-2 text-sm font-semibold text-grey1 transition-colors hover:bg-grey5/40 dark:text-light-blue/80 dark:hover:bg-white/5"
          >
            Cancel
          </button>
          <button
            onClick={handleCreate}
            disabled={!canCreate}
            className="cursor-pointer rounded-lg bg-kpmg-default px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all hover:opacity-90 hover:shadow disabled:cursor-not-allowed disabled:opacity-40 disabled:shadow-none"
          >
            Add Chart
          </button>
        </div>
      </div>
    </div>
  );
}

/* ============================================================================
 * CHAT PANEL — slide-in from right, mock AI assistant
 * ========================================================================== */

interface ChatMessage {
  id: string;
  role: 'user' | 'bot';
  text?: string;
  insight?: string;
  chart?: MockChartTemplate;
  added?: boolean; // tracks whether the chart in this msg has been added to dashboard
}

const FALLBACK_INSIGHT =
  "I'm not sure how to interpret that. Try asking about teams, severity trends, SLA breaches, vulnerability ages, or scan origins. You can also pick a starter prompt below.";

export function ChatPanel({
  open,
  onClose,
  onAddChart,
}: {
  open: boolean;
  onClose: () => void;
  onAddChart: (cfg: CustomChartConfig) => void;
}) {
  const [messages, setMessages] = useState<ChatMessage[]>([]);
  const [input, setInput] = useState('');
  const [typing, setTyping] = useState(false);
  const scrollRef = useRef<HTMLDivElement>(null);

  // Auto-scroll to bottom on new messages
  useEffect(() => {
    if (scrollRef.current) {
      scrollRef.current.scrollTop = scrollRef.current.scrollHeight;
    }
  }, [messages, typing]);

  // Esc closes the panel
  useEffect(() => {
    if (!open) return;
    const handler = (e: KeyboardEvent) => {
      if (e.key === 'Escape') onClose();
    };
    window.addEventListener('keydown', handler);
    return () => window.removeEventListener('keydown', handler);
  }, [open, onClose]);

  const send = (text: string) => {
    const trimmed = text.trim();
    if (!trimmed) return;

    const userMsg: ChatMessage = {
      id: `u-${Date.now()}`,
      role: 'user',
      text: trimmed,
    };
    setMessages((prev) => [...prev, userMsg]);
    setInput('');
    setTyping(true);

    // Simulate bot thinking time
    setTimeout(() => {
      const match = findMockMatch(trimmed);
      const botMsg: ChatMessage = match
        ? {
            id: `b-${Date.now()}`,
            role: 'bot',
            insight: match.insight,
            chart: match.chart,
          }
        : {
            id: `b-${Date.now()}`,
            role: 'bot',
            insight: FALLBACK_INSIGHT,
          };
      setMessages((prev) => [...prev, botMsg]);
      setTyping(false);
    }, 600);
  };

  const handleAddToDashboard = (msgId: string, chart: MockChartTemplate) => {
    onAddChart({
      id: `custom-${Date.now()}`,
      title: chart.title,
      source: chart.source,
      chartKind: chart.chartKind,
      selectedSeries: chart.selectedSeries,
      xAxisField: chart.xAxisField,
      swapAxes: chart.swapAxes,
    });
    setMessages((prev) =>
      prev.map((m) => (m.id === msgId ? { ...m, added: true } : m)),
    );
  };

  const handleStarter = (prompt: string) => send(prompt);

  return (
    <>
      {/* Backdrop */}
      {open && (
        <div
          className="fixed !z-[9999]  inset-0 z-30 bg-dark-blue/30 backdrop-blur-[2px]"
          onClick={onClose}
        />
      )}

      {/* Panel */}
      <aside
        className={`fixed !z-[9999] inset-y-0 right-0 z-40 flex w-full max-w-[420px] transform flex-col border-l border-grey5 bg-white shadow-2xl transition-transform duration-300 dark:border-white/10 dark:bg-[#111C44] ${
          open ? 'translate-x-0' : 'translate-x-full'
        }`}
        aria-hidden={!open}
      >
        {/* Header */}
        <div className="flex items-center justify-between border-b border-grey5 px-4 py-3 dark:border-white/10">
          <div className="flex items-center gap-2">
            <div className="flex h-8 w-8 items-center justify-center rounded-lg bg-purple/15 text-purple dark:bg-light-purple/20 dark:text-light-purple">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                <path d="M12 2 L13.5 8.5 L20 10 L13.5 11.5 L12 18 L10.5 11.5 L4 10 L10.5 8.5 Z" />
                <path d="M19 3 L19.5 5 L21.5 5.5 L19.5 6 L19 8 L18.5 6 L16.5 5.5 L18.5 5 Z" />
              </svg>
            </div>
            <div>
              <h2 className="text-sm font-bold text-dark-blue dark:text-white">AI Assistant</h2>
              <p className="text-[10px] font-normal text-grey2 dark:text-light-blue/60">
                Ask about your security data
              </p>
            </div>
          </div>
          <button
            onClick={onClose}
            className="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-grey2 transition-colors hover:bg-grey5/40 hover:text-dark-blue dark:text-light-blue/60 dark:hover:bg-white/5 dark:hover:text-white"
            aria-label="Close chat"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>

        {/* Messages */}
        <div ref={scrollRef} className="flex-1 overflow-y-auto px-4 py-4">
          {messages.length === 0 ? (
            <ChatWelcome onPick={handleStarter} />
          ) : (
            <div className="flex flex-col gap-3">
              {messages.map((msg) =>
                msg.role === 'user' ? (
                  <UserBubble key={msg.id} text={msg.text ?? ''} />
                ) : (
                  <BotBubble
                    key={msg.id}
                    insight={msg.insight ?? ''}
                    chart={msg.chart}
                    added={msg.added}
                    onAdd={() =>
                      msg.chart && handleAddToDashboard(msg.id, msg.chart)
                    }
                  />
                ),
              )}
              {typing && <TypingIndicator />}
            </div>
          )}
        </div>

        {/* Input */}
        <div className="border-t border-grey5 p-3 dark:border-white/10">
          <form
            onSubmit={(e) => {
              e.preventDefault();
              send(input);
            }}
            className="flex items-end gap-2"
          >
            <textarea
              value={input}
              onChange={(e) => setInput(e.target.value)}
              onKeyDown={(e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                  e.preventDefault();
                  send(input);
                }
              }}
              rows={1}
              placeholder="Ask about your data..."
              className="flex-1 resize-none rounded-lg border border-grey5 bg-grey5/20 px-3 py-2 text-sm text-dark-blue outline-none transition-colors focus:border-kpmg-default focus:bg-white dark:border-white/10 dark:bg-[#060B28] dark:text-white dark:focus:bg-[#0F172A]"
              style={{ minHeight: '38px', maxHeight: '100px' }}
            />
            <button
              type="submit"
              disabled={!input.trim() || typing}
              className="flex h-[38px] w-[38px] cursor-pointer items-center justify-center rounded-lg bg-purple text-white shadow-sm transition-all hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-40 dark:bg-light-purple dark:text-dark-blue"
              aria-label="Send"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                <line x1="22" y1="2" x2="11" y2="13" />
                <polygon points="22 2 15 22 11 13 2 9 22 2" />
              </svg>
            </button>
          </form>
        </div>
      </aside>
    </>
  );
}

