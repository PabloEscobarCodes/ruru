/** Chart kinds — horizontal-bar removed (use swapAxes on a bar chart instead). */
export type ChartKind = 'bar' | 'stacked-bar' | 'line' | 'pie' | 'doughnut';

/** What dimension goes on the X-axis (or becomes the slices for pie/doughnut). */
export type XAxisField = 'labels' | 'series';

export interface CustomChartConfig {
  id: string;
  title: string;
  source: DataSourceKey;
  chartKind: ChartKind;
  selectedSeries: DatasetKey[];
  /** 'labels' = source labels on X (default). 'series' = transposed (selected series labels on X). */
  xAxisField: XAxisField;
  /** Flip chart orientation (vertical ↔ horizontal). Ignored for pie/doughnut. */
  swapAxes: boolean;
}

/* ============================================================================
 * CHATBOT MOCK DATA — query → insight + chart config
 * ========================================================================== */

export interface MockChartTemplate {
  title: string;
  source: DataSourceKey;
  chartKind: ChartKind;
  selectedSeries: DatasetKey[];
  xAxisField: XAxisField;
  swapAxes: boolean;
}

export interface MockQuery {
  /** Lowercase keywords. Match score = how many keywords appear in the query. */
  keywords: string[];
  insight: string;
  chart: MockChartTemplate;
}

